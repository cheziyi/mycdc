{
  "name": "ComfortDelGro Driving Centre bookings in your calendar",
  "short_name": "mycdc.app",
  "description": "Unofficial. Subscribe to your ComfortDelGro Driving Centre bookings from the calendar you already use.",
  "lang": "en-SG",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#eef1f6",
  "theme_color": "#1a6cf0",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
